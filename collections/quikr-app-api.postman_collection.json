    "name": "Quikr Developer Platform (QDP) App API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Quikr Developer Platform (QDP) exposes India's Quikr online classifieds to approved partner apps: discover ads by location or category, surface trending and live activity, reply to listings, and post/edit ads. The platform is in beta with invitation-only access (request via dvlpr-support@quikr.com). Authentication uses custom Quikr HMAC-SHA1 signed headers, not OAuth.\n\nContact Support:\n Name: Quikr Developer Support\n Email: dvlpr-support@quikr.com",
      "type": "text/plain"
    }
  }
